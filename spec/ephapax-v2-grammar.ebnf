(*
 * Ephapax v2 Grammar Specification
 * ================================
 *
 * This file and src/ephapax-parser/src/ephapax.pest are ONE normative
 * grammar (v2 plan rung E7; owner decision 2026-11-10: the parser
 * grammar is the source).
 *
 * Architecture:
 *   SURFACE GRAMMAR (this file) -> desugar -> CORE CALCULUS
 *
 * The core calculus (binary sums, case, inl/inr, let/let!, regions)
 * remains unchanged. Everything here desugars into it.
 *
 * The file has 2 parts.
 *
 * PART 1: THE PARSER GRAMMAR. It says what the parser accepts. A test
 *   makes it from ephapax.pest, and fails when the 2 files are not the
 *   same grammar. Do not edit part 1 by hand. After a change of
 *   ephapax.pest, run:
 *
 *     UPDATE_GRAMMAR=1 cargo test -p ephapax-parser grammar_conformance
 *
 *   Each rule is in the parse tree of a fixture in
 *   tests/v2-grammar/productions.
 *
 *   A rule with the name `unimplemented_<production>` is in part 1 for
 *   one purpose: the parser finds that syntax and refuses the program
 *   with an error that names `<production>`. The parser accepts no
 *   program that has such a rule in its parse tree.
 *
 * PART 2: THE V2 DESIGN, NOT IN THE PARSER BY THAT NAME. These are the
 *   productions of the v2 design grammar that are not rules of the
 *   parser: traits, effect and handler declarations, the comptime meta
 *   plane, contracts, capabilities, and some other forms. Each one is as
 *   the design wrote it, and each one has a mark on the line before it:
 *
 *     [ALIAS rule]      The parser has the construct as `rule` of part 1.
 *                       Part 1 is the current form.
 *     [UNIMPLEMENTED]   The parser does not have it. The parser refuses
 *                       the fixture that the mark names, with an error
 *                       that names the production after `as`
 *                       (ParseError::Unimplemented). A production that is
 *                       only inside another one has the name of the outer
 *                       production there.
 *
 *   A "DESIGN FORM" comment keeps the design form of a production that
 *   part 1 has in a smaller form.
 *
 *   The specification does not shrink: a production leaves part 2 only
 *   when the parser has it. Which form wins, where the design and the
 *   parser write one construct in 2 ways, is an owner decision for each
 *   construct.
 *
 * The same test counts the productions: each one is a rule of the parser,
 * an alias, or a refused production. 0 productions are unaccounted for.
 *
 * Notation of part 1 (ISO EBNF, with 2 additions for a PEG):
 *   a , b      a, then b          a | b     a, or else b (the first match)
 *   [ a ]      a or nothing       { a }     a, 0 or more times
 *   { a }-     a, 1 or more times
 *   &( a )     a follows here (lookahead, takes no input)
 *   !( a )     a does not follow here (lookahead, takes no input)
 *   ? ... ?    a character range, or a character with no printed form
 *   Names in upper case with no production are from pest:
 *   ASCII_ALPHA, ASCII_ALPHA_UPPER, ASCII_ALPHANUMERIC, ASCII_DIGIT, ANY
 *   (one character), SOI and EOI (start and end of the input).
 *   White space and comments (WHITESPACE, COMMENT) can stand between 2
 *   parts of a production, but not in an atomic production.
 *
 * Two planes of the design:
 *   DATA PLANE  - runtime, linear/affine, regions, effects
 *   META PLANE  - compile-time, total, pure, unrestricted
 *
 * The meta plane (comptime) can observe types and generate code.
 * It cannot reference runtime values or violate linearity.
 * Harvard separation: meta plane output is validated by the type checker.
 * See ../V1-TO-V2.adoc for the v1 -> v2 story.
 *)


(* ################################################################ *)
(* PART 1: THE PARSER GRAMMAR                                       *)
(* ################################################################ *)

(* BEGIN GENERATED: the parser grammar, from ephapax.pest. Do not edit. *)


(* Ephapax Grammar - PEG Parser *)

(* Top-level rules *)
module = SOI , [ module_decl ] , { unimplemented_reexport | unimplemented_import | import_decl | declaration } , EOI ;
expression_only = SOI , expression , EOI ;

(* Module Declaration *)

module_decl = "module" , qualified_name , [ unimplemented_capability_decl ] ;

(* Only the header, for `declared_module_name`. *)
module_header = SOI , module_decl ;

(* Qualified name: Foo.Bar.Baz OR Foo/Bar/Baz (slash- and dot-segments both *)
(* allowed and treated as equivalent at the AST level - see canonicalisation *)
(* in `parse_module` / `parse_surface_module`). Slash-paths matter for the *)
(* `hypatia/ui/bridge` style used by downstream consumers; dot-paths are *)
(* historical. *)
qualified_name = ( ASCII_ALPHA | "_" ) , { ASCII_ALPHANUMERIC | "_" | "." | "/" } ; (* atomic: no white space between the parts *)

(* Imports *)

import_decl = "import" , qualified_name , [ "(" , identifier , { "," , identifier } , ")" ] ;

(* Syntax of the v2 design that is not implemented *)
(* A rule with the name `unimplemented_<production>` is in this grammar *)
(* for one purpose: the parser finds the syntax and refuses the program *)
(* with an error that names `<production>` (`ParseError::Unimplemented`). *)
(* The production is in part 2 of spec/ephapax-v2-grammar.ebnf with the *)
(* mark [UNIMPLEMENTED]. Each rule stands only where no valid program can *)
(* have its first token, so it changes no program that parsed before. *)

(* The body of `( ... )` when its contents have no grammar yet. *)
paren_body = { string | "(" , paren_body , ")" | !( "(" | ")" ) , ANY } ; (* silent: no node in the parse tree *)

(* A word of the v2 design, as a full word (`where`, not the start of *)
(* `wherever`). Atomic: white space cannot stand before the check. *)
design_word = ( "where" | "requires" | "ensures" | "invariant" | "trait" | "impl" | "effect" | "handler" | "with" ) , !( ASCII_ALPHANUMERIC | "_" ) ; (* atomic: no white space between the parts *)

(* import Foo from "foo" / import { a, b } from "foo" / import * as Foo from "foo" *)
unimplemented_import = "import" , ( identifier | "{" , identifier , { "," , identifier } , "}" | "*" , "as" , identifier ) , "from" , string ;

(* pub import ... *)
unimplemented_reexport = visibility , ( unimplemented_import | import_decl ) ;

(* module m capabilities: [io, network] *)
unimplemented_capability_decl = "capabilities" , ":" , "[" , identifier , { "," , identifier } , "]" ;

(* @capabilities(io) *)
unimplemented_capability_annotation = "@capabilities" , "(" , paren_body , ")" ;

(* @name(args) *)
unimplemented_annotation_args = "(" , paren_body , ")" ;

(* @comptime { ... }, and the 4 declarations with an `end`: the rule takes *)
(* the rest of the file, because the bodies have no grammar yet. *)
unimplemented_comptime_decl = "@comptime" , "{" , { ANY } ;
unimplemented_trait_decl = [ visibility ] , &( "trait" ) , design_word , { ANY } ;
unimplemented_impl_decl = [ visibility ] , &( "impl" ) , design_word , { ANY } ;
unimplemented_effect_decl = [ visibility ] , &( "effect" ) , design_word , { ANY } ;
unimplemented_handler_decl = [ visibility ] , &( "handler" ) , design_word , { ANY } ;

(* fn show<a: Show + Eq>(...) *)
unimplemented_type_param = ":" , constructor_name , { "+" , constructor_name } ;

(* fn f(...): T where a: Show, b: Eq = ... *)
unimplemented_where_clause = &( "where" ) , design_word , identifier , unimplemented_type_param , { "," , identifier , unimplemented_type_param } ;

(* fn f(...): T requires e ensures e invariant e = ... *)
unimplemented_contract_clause = &( "requires" | "ensures" | "invariant" ) , design_word , expression ;

(* T with IO + State(I32) *)
unimplemented_effect_ty = &( "with" ) , design_word , ( constructor_name , [ "(" , ty_list , ")" ] | identifier ) , { "+" , ( constructor_name , [ "(" , ty_list , ")" ] | identifier ) } ;

(* A * B *)
unimplemented_prod_ty = "*" ;

(* (a, b, c) as a pattern, and &p *)
unimplemented_tuple_pattern = "(" , pattern , "," , pattern , { "," , pattern }- , ")" ;
unimplemented_borrow_pattern = "&" , pattern ;

(* handle shallow e with ...: `shallow`, white space, then the start of a *)
(* name, a number or a string. `handle shallow(x) with` is a call. *)
unimplemented_handle_mode = "shallow" , { " " | ? TAB ? | ? LF ? | ? CR ? }- , &( ASCII_ALPHANUMERIC | "_" | '"' ) ; (* atomic: no white space between the parts *)

(* handle e with h end *)
unimplemented_handler_ref = identifier , &( "end" ) ;

(* | finally => e *)
unimplemented_finally_clause = "finally" , "=>" , expression ;

(* | op(x), resume => e *)
unimplemented_inline_op_clause = "," , resume_param ;

(* a ++ b, *e, @splice(...), @type_desc_of(T) *)
unimplemented_concat_expr = "++" ;
unimplemented_deref_expr = "*" , unary_expr ;
unimplemented_comptime_splice = "@splice" , "(" , paren_body , ")" ;
unimplemented_type_desc_expr = "@type_desc_of" , "(" , ty , ")" ;

(* Declarations *)

declaration = unimplemented_comptime_decl
            | { annotation } , ( extern_block | data_decl | fn_decl | type_decl | const_decl | unimplemented_trait_decl | unimplemented_impl_decl | unimplemented_effect_decl | unimplemented_handler_decl )
            ;

(* `@identifier` decorators attached to top-level declarations. Currently *)
(* parser-only - annotations are parsed and stored on the surface AST so *)
(* they survive round-tripping, but the typechecker and codegen ignore *)
(* them. They exist so that downstream tools (hypatia's `@tail_recursive`, *)
(* future `@inline`, `@no_mangle`, etc.) can hang metadata off a decl *)
(* without breaking the parser today. *)
annotation = unimplemented_capability_annotation
           | "@" , identifier , [ unimplemented_annotation_args ]
           ;

(* Extern Blocks *)
(* `extern "abi" { items... }` declares foreign types and function *)
(* signatures. Items have no body; codegen lowers fn items to host *)
(* `import` directives and treats type items as opaque externs. *)
(* Example: *)
(* extern "gossamer" { *)
(* type Window *)
(* fn window_open(title: String, body: String): Window *)
(* } *)

extern_block = "extern" , string , "{" , { extern_item } , "}" ;
extern_item = extern_type_item | extern_fn_item ;
extern_type_item = "type" , identifier ;
extern_fn_item = "fn" , identifier , "(" , [ param_list ] , ")" , ( ":" | "->" ) , ty ;

(* Top-level constant binding: let NAME = expr *)
const_decl = "let" , identifier , [ ":" , ty ] , "=" , expression ;

(* Optional "pub" prefix for visibility *)
visibility = "pub" ;

(* Optional generic type parameters: <T>, <T, U> *)
fn_type_params = "<" , identifier , [ unimplemented_type_param ] , { "," , identifier , [ unimplemented_type_param ] } , ">" ;

fn_decl = [ visibility ] , "fn" , identifier , [ fn_type_params ] , "(" , [ param_list ] , ")" , ( ":" | "->" ) , ty , { unimplemented_where_clause | unimplemented_contract_clause } , "=" , expression ;

param_list = param , { "," , param } ;

param = identifier , ":" , ty ;

type_decl = [ visibility ] , [ linearity ] , "type" , identifier , "=" , ( named_record_type_def | record_type_def | sum_type_def | ty ) ;

(* Named record: TypeName = ConstructorName { field: Type, ... } *)
named_record_type_def = constructor_name , "{" , record_field , { "," , record_field } , [ "," ] , "}" ;

linearity = "linear" | "affine" ;

(* Data type declaration: data Option(a) = None | Some(a) *)
(* Optional `pub` prefix makes the type + its constructors importable. *)
data_decl = [ visibility ] , "data" , constructor_name , [ type_params ] , "=" , [ "|" ] , data_variant , { "|" , data_variant } ;

type_params = "(" , identifier , { "," , identifier } , ")" ;

data_variant = constructor_name , [ "(" , [ ty_list ] , ")" ] ;
ty_list = ty , { "," , ty } ;

(* Constructor names start with uppercase *)
constructor_name = ASCII_ALPHA_UPPER , { ASCII_ALPHANUMERIC | "_" } ; (* atomic: no white space between the parts *)

sum_type_def = [ "|" ] , sum_variant , { "|" , sum_variant } ;
sum_variant = identifier , [ "(" , ty , ")" ] ;

record_type_def = "{" , record_field , { "," , record_field } , [ "," ] , "}" ;
record_field = identifier , ":" , ty ;

(* Types *)

ty = sum_ty , [ "->" , ty ] , [ unimplemented_effect_ty ] ;

sum_ty = type_atom , { ( "+" | unimplemented_prod_ty ) , type_atom } ;

type_atom = base_ty
          | string_ty
          | borrow_ty
          | list_ty
          | product_ty
          | record_ty
          | named_ty
          | type_var
          ;

(* Type variables are single lowercase or uppercase identifiers that are NOT *)
(* constructor names with arguments. The named_ty rule handles constructors. *)
(* For single uppercase letters like T, A, B - the parser tries named_ty first, *)
(* which matches as a nullary constructor. The type checker resolves whether *)
(* it's a type variable or a constructor based on scope. *)

(* Named type application: Option(I32), Result(String@r, Error), Color *)
(* Nullary named types (no parens) are also valid: Color, Unit, etc. *)
named_ty = constructor_name , [ "(" , ty_list , ")" ] ;

record_ty = "{" , record_field , { "," , record_field } , "}" ;

base_ty = unit_ty | "Bool" | "I32" | "I64" | "F32" | "F64" ;
unit_ty = "()" ;

string_ty = "String" , [ "@" , identifier ] ;

borrow_ty = "&" , [ mut_marker ] , type_atom ;

mut_marker = "mut" , !( ASCII_ALPHANUMERIC | "_" ) ; (* atomic: no white space between the parts *)

list_ty = "[" , ty , "]" ;

product_ty = "(" , ty , { "," , ty }- , ")" ;

type_var = identifier ;

(* Expressions *)

expression = seq_expr ;

(* Statement sequencing: e1 ; e2 ; e3  (last expression is the result) *)
seq_expr = single_expr , { ";" , single_expr } ;

single_expr = block_expr
            | let_lin_expr
            | let_expr
            | lambda_expr
            | if_expr
            | region_expr
            | match_expr
            | case_expr
            | handle_expr
            | or_expr
            ;

(* One or more `sequential_let`s followed by a trailing result expression. *)
(* The trailing expression can itself be any `expression` (which folds back *)
(* through `seq_expr` / `single_expr`), so nested block forms and explicit *)
(* `let ... in ...` both compose normally. *)
block_expr = { sequential_let }- , expression ;

sequential_let = ( "let!" | "let" ) , let_binder , [ ":" , ty ] , "=" , block_rhs ;

(* A `sequential_let`'s rhs may be any expression form *except* a top-level *)
(* `let`/`let!` - those participate in the block via the next iteration of *)
(* `sequential_let`. *)
block_rhs = lambda_expr
          | if_expr
          | region_expr
          | match_expr
          | case_expr
          | handle_expr
          | or_expr
          ;

(* Pattern matching: match x of | None => 0 | Some(v) => v end *)
match_expr = "match" , expression , "of" , [ "|" ] , match_arm , { "|" , match_arm } , "end" ;

match_arm = pattern , [ "if" , expression ] , "=>" , expression ;

pattern = constructor_pattern
        | pair_pattern
        | unimplemented_tuple_pattern
        | wildcard_pattern
        | literal_pattern
        | unimplemented_borrow_pattern
        | var_pattern
        ;

(* `Some(x)`, `None`, and with the module that declares the type: *)
(* `shapes.Rect(w, h)`. The module must be an import of this module. *)
constructor_pattern = [ pattern_qualifier , "." ] , constructor_name , [ "(" , [ pattern_list ] , ")" ] ;
pattern_qualifier = identifier ;
pair_pattern = "(" , pattern , "," , pattern , ")" ;
wildcard_pattern = "_" ;
literal_pattern = literal ;
var_pattern = identifier ;

pattern_list = pattern , { "," , pattern } ;

let_expr = "let" , let_binder , [ ":" , ty ] , "=" , expression , "in" , expression ;

let_lin_expr = "let!" , let_binder , [ ":" , ty ] , "=" , expression , "in" , expression ;

(* Either a single identifier (the common case) or a parenthesised tuple *)
(* of identifiers for destructuring binds: *)
(* let (a, b) = pair() in ... *)
(* let! (ch2, msg_bytes) = ipc_recv(ch) in ... *)
(* Tuple binders desugar to a 1-arm `match scrutinee of | (a, b) => body end` *)
(* at parse time, reusing the existing pair-pattern handling. *)
let_binder = tuple_binder | identifier ;
tuple_binder = "(" , identifier , { "," , identifier }- , ")" ;

lambda_expr = "fn" , "(" , identifier , ":" , ty , ")" , "->" , expression ;

if_expr = "if" , expression , "then" , expression , "else" , expression ;

region_expr = "region" , identifier , ( ":" | "{" ) , expression , [ "}" ] ;

case_expr = "case" , expression , "of" , "inl" , "(" , identifier , ")" , "->" , expression , "inr" , "(" , identifier , ")" , "->" , expression , "end" ;

(* Effect handling: handle expr with { return(x) => e | Op(args, resume) => e } end *)
handle_expr = "handle" , ( unimplemented_handle_mode , expression | expression ) , "with" , ( unimplemented_handler_ref | [ "|" ] , handler_clause , { "|" , handler_clause } ) , "end" ;

handler_clause = handler_return_clause | unimplemented_finally_clause | handler_op_clause ;

(* return(x) => expr *)
handler_return_clause = "return" , "(" , identifier , ")" , "=>" , expression ;

(* Op(param1, param2, resume) => expr *)
(* resume may optionally have a mode: resume(once) or resume(multi) *)
handler_op_clause = identifier , "(" , [ handler_param_list ] , ")" , [ unimplemented_inline_op_clause ] , "=>" , expression ;

handler_param_list = handler_param , { "," , handler_param } ;
handler_param = resume_param | identifier ;

resume_param = "resume" , [ "(" , resume_mode , ")" ] ;
resume_mode = "once" | "multi" ;

(* Binary Operators (by precedence, lowest to highest) *)

or_expr = and_expr , { "||" , and_expr } ;

and_expr = eq_expr , { "&&" , eq_expr } ;

eq_expr = cmp_expr , { eq_op , cmp_expr } ;
eq_op = "==" | "!=" ;

cmp_expr = add_expr , { cmp_op , add_expr } ;
cmp_op = "<=" | ">=" | "<" | ">" ;

add_expr = mul_expr , { ( unimplemented_concat_expr | add_op ) , mul_expr } ;
add_op = "+" | "-" ;

mul_expr = unary_expr , { mul_op , unary_expr } ;
mul_op = "*" | "/" | "%" ;

(* Unary and Postfix Expressions *)

unary_expr = "!" , unary_expr | "-" , unary_expr | unimplemented_deref_expr | postfix_expr ;

postfix_expr = atom_expr , { postfix_op } ;

postfix_op = call_op | type_app_op | index_op | member_op ;

call_op = "(" , [ call_args ] , ")" ;
call_args = expression , { "," , expression } ;
(* Explicit type arguments of a generic function: `id[I32](3)`. Only *)
(* before a call, and before `index_op`: `xs[i](3)` has the two readings *)
(* when `i` is one name. The desugarer reads that case as an index, unless *)
(* the name is a type parameter of the function it is in. *)
type_app_op = "[" , ty_list , "]" , &( "(" ) ;
index_op = "[" , expression , "]" ;
member_op = "." , ( integer | identifier | constructor_name ) ;

(* Atomic Expressions *)

atom_expr = unimplemented_comptime_splice
          | unimplemented_type_desc_expr
          | perform_expr
          | ffi_expr
          | string_method
          | inl_expr
          | inr_expr
          | borrow_expr
          | fst_expr
          | snd_expr
          | drop_expr
          | copy_expr
          | construct_expr
          | record_literal
          | list_literal
          | paren_or_pair
          | literal
          | variable
          ;

(* Perform an effect operation: perform Op(args...) *)
perform_expr = "perform" , identifier , [ "(" , [ expr_list ] , ")" ] ;

(* Named constructor: Some(42), None, Ok(value), or named record: GsaApp { field = val } *)
construct_expr = constructor_name , [ "(" , [ expr_list ] , ")" | "{" , record_field_assign , { "," , record_field_assign } , [ "," ] , "}" ] ;

(* FFI call: __ffi("symbol_name", arg1, arg2, ...) *)
(* Calls a C ABI function from a linked shared library. *)
ffi_expr = "__ffi" , "(" , string , { "," , expression } , ")" ;

record_literal = "{" , record_field_assign , { "," , record_field_assign } , [ "," ] , "}" ;
(* Three surface forms, all producing the same AST node: *)
(* 1. `field: ty = value`  (typed, explicit assignment) *)
(* 2. `field = value`      (untyped, explicit assignment) *)
(* 3. `field: value`       (ML/Haskell-style shorthand - value *)
(* expression directly after `:`, no `=`) *)
(* PEG ordering: the `=` forms are tried first; the shorthand fires *)
(* only when no `=` follows the named-ty. *)
record_field_assign = identifier , ":" , ty , "=" , expression
                    | identifier , "=" , expression
                    | identifier , ":" , expression
                    ;

string_method = "String" , "." , identifier , [ "@" , identifier ] , "(" , [ expr_list ] , ")" ;

expr_list = expression , { "," , expression } ;

inl_expr = "inl" , "[" , ty , "]" , "(" , expression , ")" ;
inr_expr = "inr" , "[" , ty , "]" , "(" , expression , ")" ;

borrow_expr = "&" , [ mut_marker ] , unary_expr ;

fst_expr = "fst" , "(" , expression , ")" ;
snd_expr = "snd" , "(" , expression , ")" ;
drop_expr = "drop" , "(" , expression , ")" ;
copy_expr = "copy" , "(" , expression , ")" ;

list_literal = "[" , [ expression , { "," , expression } ] , "]" ;

paren_or_pair = "(" , [ expression , { "," , expression } ] , ")" ;

variable = identifier ;

(* Literals *)

literal = unit_literal | boolean | float32 | float | integer | string ;

unit_literal = "()" ;
boolean = "true" | "false" ;

integer = { ASCII_DIGIT }- ; (* atomic: no white space between the parts *)
float = { ASCII_DIGIT }- , "." , { ASCII_DIGIT }- ; (* atomic: no white space between the parts *)
(* An F32 literal carries the `f32` suffix (`1.5f32`); an unsuffixed float *)
(* literal is F64. *)
float32 = { ASCII_DIGIT }- , "." , { ASCII_DIGIT }- , "f32" ; (* atomic: no white space between the parts *)

string = '"' , string_inner , '"' ; (* atomic: no white space between the parts *)
string_inner = { escape | !( '"' | "\" ) , ANY } ; (* atomic: no white space between the parts *)
escape = "\" , ( "n" | "r" | "t" | "\" | '"' ) ; (* atomic: no white space between the parts *)

(* Identifiers and Whitespace *)

identifier = !( keyword_boundary ) , ( ASCII_ALPHA | "_" ) , { ASCII_ALPHANUMERIC | "_" } ; (* atomic: no white space between the parts *)

(* Keywords must be followed by a non-identifier character (word boundary) *)
keyword_boundary = ( "let!" | "let" | "in" | "fn" | "if" | "then" | "else" | "region" | "case" | "of" | "inl" | "inr" | "end" | "fst" | "snd" | "drop" | "copy" | "type" | "data" | "match" | "extern" | "true" | "false" | "pub" | "import" | "module" | "linear" | "mut" | "perform" | "handle" | "with" | "return" | "resume" | "once" | "multi" | "Bool" | "I32" | "I64" | "F32" | "F64" | "String" ) , !( ASCII_ALPHANUMERIC | "_" ) ;

keyword = "let"
        | "let!"
        | "in"
        | "fn"
        | "if"
        | "then"
        | "else"
        | "region"
        | "case"
        | "of"
        | "inl"
        | "inr"
        | "end"
        | "fst"
        | "snd"
        | "drop"
        | "copy"
        | "type"
        | "data"
        | "match"
        | "extern"
        | "true"
        | "false"
        | "pub"
        | "import"
        | "module"
        | "linear"
        | "mut"
        | "perform"
        | "handle"
        | "with"
        | "return"
        | "resume"
        | "once"
        | "multi"
        | "Bool"
        | "I32"
        | "I64"
        | "F32"
        | "F64"
        | "String"
        ;

WHITESPACE = " " | ? TAB ? | ? LF ? | ? CR ? ; (* silent: no node in the parse tree *)
COMMENT = "--" , { !( ? LF ? ) , ANY }
        | "//" , { !( ? LF ? ) , ANY }
        | "/*" , { !( "*/" ) , ANY } , "*/"
        ; (* silent: no node in the parse tree *)

(* END GENERATED *)


(* ################################################################ *)
(* PART 2: THE V2 DESIGN, NOT IN THE PARSER BY THAT NAME            *)
(* ################################################################ *)

(* ================================================================ *)
(* 1. TOP LEVEL                                                     *)
(* ================================================================ *)

(* A source file is a module. *)
(* [ALIAS module] the parser takes imports and declarations in any order *)
source_file  = { module_header } , { import } , { top_decl } ;

(* DESIGN FORM of module_header. The parser rule module_header in part 1 is the current form.
 * This form has productions that are not implemented: capability_decl.
 *
 * module_header = "module" , module_path , [ capability_decl ] ;
 *)

(* [ALIAS qualified_name] the parser rule is the current form *)
module_path  = IDENT , { "." , IDENT } ;


(* ================================================================ *)
(* 2. MODULES AND IMPORTS                                           *)
(* ================================================================ *)

(* [UNIMPLEMENTED] refused: tests/v2-grammar/unimplemented/import_from.eph as import (the parser has import_decl: `import a/b` and `import a/b(x, y)`) *)
import       = "import" , import_spec , "from" , STRING ;

(* [UNIMPLEMENTED] refused: tests/v2-grammar/unimplemented/import_from.eph as import *)
import_spec  = IDENT                                 (* import Foo from "foo" *)
             | "{" , IDENT , { "," , IDENT } , "}"   (* import { a, b } from "foo" *)
             | "*" , "as" , IDENT                     (* import * as Foo from "foo" *)
             ;

(* Re-export: make imported names visible to importers of this module *)
(* [UNIMPLEMENTED] refused: tests/v2-grammar/unimplemented/reexport.eph as reexport *)
reexport     = "pub" , import ;


(* ================================================================ *)
(* 4. ANNOTATIONS                                                   *)
(* ================================================================ *)

(* DESIGN FORM of annotation. The parser rule annotation in part 1 is the current form.
 * This form has productions that are not implemented: annotation_args.
 *
 * annotation   = "@" , IDENT , [ "(" , annotation_args , ")" ] ;
 *)

(* [UNIMPLEMENTED] refused: tests/v2-grammar/unimplemented/annotation_args.eph as annotation_args *)
annotation_args = annotation_arg , { "," , annotation_arg } ;

(* [UNIMPLEMENTED] refused: tests/v2-grammar/unimplemented/annotation_args.eph as annotation_args *)
annotation_arg  = IDENT | STRING | INTEGER | annotation ;


(* ================================================================ *)
(* 5. DECLARATIONS                                                  *)
(* ================================================================ *)

(* [ALIAS declaration] the parser has no trait, impl, effect, handler or comptime declaration *)
top_decl     = { annotation } , visibility , decl_body ;

(* [ALIAS declaration] the parser has no trait, impl, effect, handler or comptime declaration *)
decl_body    = fn_decl
             | data_decl
             | type_decl
             | trait_decl
             | impl_decl
             | effect_decl
             | handler_decl
             | comptime_decl
             ;

(* DESIGN FORM of fn_decl. The parser rule fn_decl in part 1 is the current form.
 * This form has productions that are not implemented: contract_block, effect_annotation, where_clause.
 *
 * fn_decl      = "fn" , IDENT , [ type_params ] ,
 *                "(" , [ param_list ] , ")" , ":" , ty ,
 *                [ where_clause ] ,
 *                [ contract_block ] ,
 *                [ effect_annotation ] ,
 *                "=" , expr ;
 *)

(* DESIGN FORM of type_params. The parser rule type_params in part 1 is the current form.
 * This form has productions that are not implemented: type_param.
 *
 * type_params  = "[" , type_param , { "," , type_param } , "]" ;
 *)

(* [UNIMPLEMENTED] refused: tests/v2-grammar/unimplemented/type_param_bound.eph as type_param (the parser has type parameters with no bound: fn_type_params, type_params) *)
type_param   = IDENT , [ ":" , trait_bound ] ;

(* [UNIMPLEMENTED] refused: tests/v2-grammar/unimplemented/type_param_bound.eph as type_param *)
trait_bound  = CTOR_IDENT , { "+" , CTOR_IDENT } ;

(* [UNIMPLEMENTED] refused: tests/v2-grammar/unimplemented/where.eph as where_clause *)
where_clause = "where" , constraint , { "," , constraint } ;

(* [UNIMPLEMENTED] refused: tests/v2-grammar/unimplemented/where.eph as where_clause *)
constraint   = IDENT , ":" , trait_bound ;

(* [UNIMPLEMENTED] refused: tests/v2-grammar/unimplemented/trait.eph as trait_decl *)
trait_decl   = "trait" , CTOR_IDENT , "(" , type_param , ")" ,
               [ ":" , trait_bound ] ,  (* supertrait bounds *)
               "=" , { trait_item } , "end" ;

(* [UNIMPLEMENTED] refused: tests/v2-grammar/unimplemented/trait.eph as trait_decl *)
trait_item   = { annotation } , trait_fn_sig ;

(* [UNIMPLEMENTED] refused: tests/v2-grammar/unimplemented/trait.eph as trait_decl *)
trait_fn_sig = "fn" , IDENT , [ type_params ] ,
               "(" , [ param_list ] , ")" , ":" , ty ,
               [ "=" , expr ]  (* default implementation *)
               ;

(* [UNIMPLEMENTED] refused: tests/v2-grammar/unimplemented/impl.eph as impl_decl *)
impl_decl    = "impl" , CTOR_IDENT , "(" , ty , ")" ,
               [ where_clause ] ,
               "=" , { impl_item } , "end" ;

(* [UNIMPLEMENTED] refused: tests/v2-grammar/unimplemented/impl.eph as impl_decl *)
impl_item    = { annotation } , fn_decl ;

(* [UNIMPLEMENTED] refused: tests/v2-grammar/unimplemented/effect.eph as effect_decl *)
effect_decl  = "effect" , CTOR_IDENT , [ type_params ] , "=" ,
               { effect_op } , "end" ;

(* [UNIMPLEMENTED] refused: tests/v2-grammar/unimplemented/effect.eph as effect_decl *)
effect_op    = "fn" , IDENT , [ type_params ] ,
               "(" , [ param_list ] , ")" , ":" , ty ;

(* [UNIMPLEMENTED] refused: tests/v2-grammar/unimplemented/handler_decl.eph as handler_decl *)
handler_decl = "handler" , IDENT , [ type_params ] ,
               "for" , CTOR_IDENT , [ type_params ] ,
               [ "with" , "(" , param_list , ")" ] ,  (* handler-local state *)
               "=" , { handler_clause } , "end" ;

(* DESIGN FORM of handler_clause. The parser rule handler_clause in part 1 is the current form.
 * This form has productions that are not implemented: finally_clause, op_clause.
 *
 * handler_clause = return_clause
 *                | op_clause
 *                | finally_clause
 *                ;
 *)

(* What to do when the handled computation returns normally *)
(* [ALIAS handler_return_clause] the parser rule is the current form *)
return_clause = "return" , "(" , IDENT , ")" , "=>" , expr ;

(* Handler for an effect operation *)
(* [UNIMPLEMENTED] refused: tests/v2-grammar/unimplemented/handler_decl.eph as handler_decl (the parser has handler_op_clause, with `resume` in the parameter list) *)
op_clause     = "|" , IDENT , "(" , [ param_list ] , ")" ,
                [ "," , resume_binding ] ,
                "=>" , expr ;

(* resume is the delimited continuation. resume_mode constrains
 * whether it can be called once or multiple times.
 * - once:  one-shot, safe with linear captures (REQUIRED when
 *          the continuation captures linear values)
 * - multi: multi-shot, type error if linear captures exist
 * - omitted: compiler infers from captures *)
(* [ALIAS resume_param] the parser rule is the current form *)
resume_binding = "resume" , [ "(" , resume_mode , ")" ] ;

(* Cleanup when continuation is discarded without resuming.
 * CRITICAL for linear safety: if a handler doesn't call resume,
 * any linear values captured by the continuation must be consumed.
 * The finally clause handles this. *)
(* [UNIMPLEMENTED] refused: tests/v2-grammar/unimplemented/finally.eph as finally_clause *)
finally_clause = "finally" , "=>" , expr ;

(* [UNIMPLEMENTED] refused: tests/v2-grammar/unimplemented/comptime.eph as comptime_decl *)
comptime_decl = "@comptime" , "{" , { comptime_item } , "}" ;

(* [UNIMPLEMENTED] refused: tests/v2-grammar/unimplemented/comptime.eph as comptime_decl *)
comptime_item = comptime_fn | comptime_let ;

(* [UNIMPLEMENTED] refused: tests/v2-grammar/unimplemented/comptime.eph as comptime_decl *)
comptime_fn  = "fn" , IDENT ,
               "(" , [ comptime_param_list ] , ")" , ":" , comptime_ty ,
               "=" , comptime_expr ;

(* [UNIMPLEMENTED] refused: tests/v2-grammar/unimplemented/comptime.eph as comptime_decl *)
comptime_param_list = comptime_param , { "," , comptime_param } ;

(* [UNIMPLEMENTED] refused: tests/v2-grammar/unimplemented/comptime.eph as comptime_decl *)
comptime_param      = IDENT , ":" , comptime_ty ;

(* [UNIMPLEMENTED] refused: tests/v2-grammar/unimplemented/comptime.eph as comptime_decl *)
comptime_let = "let" , IDENT , "=" , comptime_expr ;


(* ================================================================ *)
(* 6. CONTRACTS                                                     *)
(* ================================================================ *)

(* [UNIMPLEMENTED] refused: tests/v2-grammar/unimplemented/contract.eph as contract_clause *)
contract_block = { contract_clause } ;

(* [UNIMPLEMENTED] refused: tests/v2-grammar/unimplemented/contract.eph as contract_clause *)
contract_clause = "requires" , expr           (* precondition *)
                | "ensures" , result_expr     (* postcondition *)
                | "invariant" , expr          (* maintained through body *)
                ;

(* In ensures clauses, `result` refers to the return value.
 * `old(expr)` evaluates expr BEFORE the function body, capturing
 * the result as an unrestricted snapshot. This is needed because
 * linear values are consumed by the body and cannot be referenced
 * in ensures directly. old() implicitly borrows. *)
(* [UNIMPLEMENTED] refused: tests/v2-grammar/unimplemented/contract.eph as contract_clause *)
result_expr  = expr ;

(* [UNIMPLEMENTED] refused: tests/v2-grammar/unimplemented/contract.eph as contract_clause *)
old_expr     = "old" , "(" , expr , ")" ;


(* ================================================================ *)
(* 7. FFI CAPABILITIES                                              *)
(* ================================================================ *)

(* [UNIMPLEMENTED] refused: tests/v2-grammar/unimplemented/capability.eph as capability_decl *)
capability_decl = "capabilities" , ":" ,
                  "[" , capability , { "," , capability } , "]" ;

(* [UNIMPLEMENTED] refused: tests/v2-grammar/unimplemented/capability.eph as capability_decl *)
capability   = "memory_read"       (* can read from raw memory *)
             | "memory_write"      (* can write to raw memory *)
             | "io"                (* can perform I/O *)
             | "network"           (* can access network *)
             | "filesystem"        (* can access filesystem *)
             | "process"           (* can spawn/signal processes *)
             | "ffi_unrestricted"  (* no restrictions - escape hatch *)
             | IDENT               (* user-defined capability *)
             ;

(* DESIGN FORM of ffi_expr. The parser rule ffi_expr in part 1 is the current form.
 * This form has productions that are not implemented: capability_annotation.
 *
 * ffi_expr     = "__ffi" , [ capability_annotation ] ,
 *                "(" , STRING , { "," , expr } , ")" ;
 *)

(* [UNIMPLEMENTED] refused: tests/v2-grammar/unimplemented/capability_annotation.eph as capability_annotation *)
capability_annotation = "@capabilities" ,
                        "(" , capability , { "," , capability } , ")" ;


(* ================================================================ *)
(* 8. TYPES                                                         *)
(* ================================================================ *)

(* DESIGN FORM of ty. The parser rule ty in part 1 is the current form.
 * This form has productions that are not implemented: effect_ty.
 *
 * ty           = effect_ty ;
 *)

(* Effect annotation on function types: a -> b with IO + State(s) *)
(* [UNIMPLEMENTED] refused: tests/v2-grammar/unimplemented/effect_ty.eph as effect_ty *)
effect_ty    = fun_ty , [ "with" , effect_row ] ;

(* Effect rows support both concrete effects and effect variables.
 * Effect variables are introduced in type_params and allow
 * polymorphism over effects:
 *   fn map[a, b, E: Effect](f: a -> b with E, xs: List(a)): List(b) with E
 * No `with` clause = pure (no effects). *)
(* [UNIMPLEMENTED] refused: tests/v2-grammar/unimplemented/effect_row.eph as effect_ty *)
effect_row   = effect_ref , { "+" , effect_ref }
             | IDENT                                  (* effect variable *)
             | effect_ref , { "+" , effect_ref } , "+" , IDENT  (* concrete + variable *)
             ;

(* [UNIMPLEMENTED] refused: tests/v2-grammar/unimplemented/effect_row.eph as effect_ty *)
effect_ref   = CTOR_IDENT , [ "(" , ty_list , ")" ] ;

(* [ALIAS ty] the parser rule is the current form *)
fun_ty       = sum_ty , [ "->" , ty ] ;

(* DESIGN FORM of sum_ty. The parser rule sum_ty in part 1 is the current form.
 * This form has productions that are not implemented: prod_ty.
 *
 * sum_ty       = prod_ty , { "+" , prod_ty } ;
 *)

(* [UNIMPLEMENTED] refused: tests/v2-grammar/unimplemented/prod_ty.eph as prod_ty *)
prod_ty      = type_atom , { "*" , type_atom } ;

(* [ALIAS product_ty] the parser rule is the current form *)
tuple_ty     = "(" , ty , "," , ty , { "," , ty } , ")" ;


(* ================================================================ *)
(* 9. EXPRESSIONS                                                   *)
(* ================================================================ *)

(* [ALIAS expression] the parser rule is the current form *)
expr         = let_expr
             | let_lin_expr
             | lambda_expr
             | if_expr
             | match_expr
             | region_expr
             | case_expr
             | handle_expr
             | perform_expr
             | or_expr
             ;

(* DESIGN FORM of lambda_expr. The parser rule lambda_expr in part 1 is the current form.
 * This form has productions that are not implemented: effect_annotation.
 *
 * lambda_expr  = "fn" , [ type_params ] ,
 *                "(" , [ param_list ] , ")" ,
 *                [ ":" , ty ] ,
 *                [ effect_annotation ] ,
 *                "->" , expr ;
 *)

(* [UNIMPLEMENTED] refused: tests/v2-grammar/unimplemented/effect_row.eph as effect_ty *)
effect_annotation = "with" , effect_row ;

(* DESIGN FORM of handle_expr. The parser rule handle_expr in part 1 is the current form.
 * This form has productions that are not implemented: handle_mode, handler_ref.
 *
 * handle_expr  = "handle" , [ handle_mode ] , expr , "with" ,
 *                handler_ref , "end" ;
 *)

(* [UNIMPLEMENTED] refused: tests/v2-grammar/unimplemented/handle_mode.eph as handle_mode *)
handle_mode  = "shallow" ;

(* [UNIMPLEMENTED] refused: tests/v2-grammar/unimplemented/handler_ref.eph as handler_ref *)
handler_ref  = IDENT                         (* named handler *)
             | [ "(" , param_list , ")" ] ,  (* handler-local state *)
               { inline_handler_clause }     (* inline handler *)
             ;

(* [ALIAS handler_clause] the parser has no finally clause *)
inline_handler_clause = return_clause | inline_op_clause | finally_clause ;

(* [UNIMPLEMENTED] refused: tests/v2-grammar/unimplemented/resume_after_params.eph as inline_op_clause (the parser has handler_op_clause, with `resume` in the parameter list) *)
inline_op_clause = "|" , IDENT , "(" , [ param_list ] , ")" ,
                   [ "," , resume_binding ] ,
                   "=>" , expr ;


(* ================================================================ *)
(* 10. PATTERNS                                                     *)
(* ================================================================ *)

(* DESIGN FORM of pattern. The parser rule pattern in part 1 is the current form.
 * This form has productions that are not implemented: borrow_pattern, tuple_pattern.
 *
 * pattern      = constructor_pattern
 *              | pair_pattern
 *              | tuple_pattern
 *              | wildcard_pattern
 *              | literal_pattern
 *              | borrow_pattern
 *              | var_pattern
 *              | "(" , pattern , ")"
 *              ;
 *)

(* [UNIMPLEMENTED] refused: tests/v2-grammar/unimplemented/tuple_pattern.eph as tuple_pattern (the parser has the pattern of 2 parts as pair_pattern) *)
tuple_pattern   = "(" , pattern , "," , pattern , { "," , pattern } , ")" ;

(* [UNIMPLEMENTED] refused: tests/v2-grammar/unimplemented/borrow_pattern.eph as borrow_pattern *)
borrow_pattern   = "&" , pattern ;


(* ================================================================ *)
(* 11. BINARY AND UNARY OPERATORS                                   *)
(* ================================================================ *)

(* DESIGN FORM of mul_expr. The parser rule mul_expr in part 1 is the current form.
 * This form has productions that are not implemented: concat_expr.
 *
 * mul_expr     = concat_expr , { ( "*" | "/" | "%" ) , concat_expr } ;
 *)

(* [UNIMPLEMENTED] refused: tests/v2-grammar/unimplemented/concat.eph as concat_expr *)
concat_expr  = unary_expr , { "++" , unary_expr } ;


(* ================================================================ *)
(* 12. ATOMIC EXPRESSIONS                                           *)
(* ================================================================ *)

(* DESIGN FORM of atom_expr. The parser rule atom_expr in part 1 is the current form.
 * This form has productions that are not implemented: comptime_splice, deref_expr, type_desc_expr.
 *
 * atom_expr    = ffi_expr
 *              | string_method
 *              | inl_expr
 *              | inr_expr
 *              | borrow_expr
 *              | deref_expr
 *              | drop_expr
 *              | copy_expr
 *              | construct_expr
 *              | list_literal
 *              | paren_or_pair
 *              | block_expr
 *              | comptime_splice
 *              | type_desc_expr
 *              | literal
 *              | variable
 *              ;
 *)

(* [UNIMPLEMENTED] refused: tests/v2-grammar/unimplemented/deref.eph as deref_expr *)
deref_expr   = "*" , unary_expr ;

(* Splice comptime result into runtime code *)
(* [UNIMPLEMENTED] refused: tests/v2-grammar/unimplemented/splice.eph as comptime_splice *)
comptime_splice = "@splice" , "(" , comptime_expr , ")" ;

(* Runtime type descriptor (unrestricted value, Harvard-safe) *)
(* [UNIMPLEMENTED] refused: tests/v2-grammar/unimplemented/type_desc.eph as type_desc_expr *)
type_desc_expr = "@type_desc_of" , "(" , ty , ")" ;


(* ================================================================ *)
(* 13. COMPTIME EXPRESSIONS (META PLANE)                            *)
(* ================================================================ *)

(* [UNIMPLEMENTED] refused: tests/v2-grammar/unimplemented/comptime.eph as comptime_decl *)
comptime_ty   = "Type"           (* reified type *)
              | "TypeDesc"       (* runtime type descriptor *)
              | "SurfaceDecl"    (* surface AST declaration *)
              | "SurfaceExpr"    (* surface AST expression *)
              | "List" , "(" , comptime_ty , ")"
              | "Bool"
              | "I32"
              | "String"
              | IDENT
              ;

(* [UNIMPLEMENTED] refused: tests/v2-grammar/unimplemented/comptime.eph as comptime_decl *)
comptime_expr = comptime_intrinsic
              | comptime_match
              | comptime_if
              | comptime_let_in
              | comptime_call
              | comptime_list
              | comptime_literal
              | IDENT
              ;

(* [UNIMPLEMENTED] refused: tests/v2-grammar/unimplemented/comptime.eph as comptime_decl *)
comptime_intrinsic = "@type_desc_of" , "(" , ty , ")"
                   | "@fields_of" , "(" , ty , ")"
                   | "@constructors_of" , "(" , ty , ")"
                   | "@constructor_count" , "(" , ty , ")"
                   | "@is_linear" , "(" , ty , ")"
                   | "@is_region_bound" , "(" , ty , ")"
                   | "@type_name" , "(" , ty , ")"
                   | "@has_trait" , "(" , ty , "," , CTOR_IDENT , ")"
                   | "@effect_set" , "(" , ty , ")"
                   | "@emit_decl" , "(" , comptime_expr , ")"
                   | "@emit_expr" , "(" , comptime_expr , ")"
                   | "@error" , "(" , STRING , ")"  (* compile error *)
                   | "@warning" , "(" , STRING , ")" (* compile warning *)
                   ;

(* [UNIMPLEMENTED] refused: tests/v2-grammar/unimplemented/comptime.eph as comptime_decl *)
comptime_match = "match" , comptime_expr , "of" ,
                 { "|" , comptime_pattern , "=>" , comptime_expr } ,
                 "end" ;

(* [UNIMPLEMENTED] refused: tests/v2-grammar/unimplemented/comptime.eph as comptime_decl *)
comptime_pattern = CTOR_IDENT , [ "(" , comptime_pattern_list , ")" ]
                 | "_"
                 | IDENT
                 | comptime_literal
                 ;

(* [UNIMPLEMENTED] refused: tests/v2-grammar/unimplemented/comptime.eph as comptime_decl *)
comptime_pattern_list = comptime_pattern , { "," , comptime_pattern } ;

(* [UNIMPLEMENTED] refused: tests/v2-grammar/unimplemented/comptime.eph as comptime_decl *)
comptime_if  = "if" , comptime_expr , "then" , comptime_expr ,
               "else" , comptime_expr ;

(* [UNIMPLEMENTED] refused: tests/v2-grammar/unimplemented/comptime.eph as comptime_decl *)
comptime_let_in = "let" , IDENT , "=" , comptime_expr , "in" , comptime_expr ;

(* [UNIMPLEMENTED] refused: tests/v2-grammar/unimplemented/comptime.eph as comptime_decl *)
comptime_call = IDENT , "(" , [ comptime_expr , { "," , comptime_expr } ] , ")" ;

(* [UNIMPLEMENTED] refused: tests/v2-grammar/unimplemented/comptime.eph as comptime_decl *)
comptime_list = "[" , [ comptime_expr , { "," , comptime_expr } ] , "]" ;

(* [UNIMPLEMENTED] refused: tests/v2-grammar/unimplemented/comptime.eph as comptime_decl *)
comptime_literal = INTEGER | STRING | BOOLEAN | "()" ;


(* ================================================================ *)
(* 14. TERMINALS                                                    *)
(* ================================================================ *)

(* Lowercase identifier: variables, functions, type variables *)
(* [ALIAS identifier] the parser rule is the current form *)
IDENT        = LOWER_ALPHA , { ALPHA_NUM | "_" } ;

(* Uppercase identifier: constructors, type names, trait names *)
(* [ALIAS constructor_name] the parser rule is the current form *)
CTOR_IDENT   = UPPER_ALPHA , { ALPHA_NUM | "_" } ;

(* [ALIAS integer] the parser rule is the current form *)
INTEGER      = DIGIT , { DIGIT } ;

(* [ALIAS float] the parser rule is the current form *)
FLOAT        = DIGIT , { DIGIT } , "." , DIGIT , { DIGIT } ;

(* An F32 literal carries the `f32` suffix: 1.5f32. An unsuffixed float
   literal is F64. An INTEGER is I32 when it fits, else I64; a `-` written
   directly on the digits is part of the literal. *)
(* [ALIAS float32] the parser rule is the current form *)
FLOAT32      = FLOAT , "f32" ;

(* [ALIAS boolean] the parser rule is the current form *)
BOOLEAN      = "true" | "false" ;

(* [ALIAS string] the parser rule is the current form *)
STRING       = '"' , { CHAR } , '"' ;

(* [ALIAS ASCII_ALPHA] the parser takes an upper-case letter at the start of an identifier too *)
LOWER_ALPHA  = "a" | ... | "z" | "_" ;

(* [ALIAS ASCII_ALPHA_UPPER] the parser rule is the current form *)
UPPER_ALPHA  = "A" | ... | "Z" ;

(* [ALIAS ASCII_ALPHANUMERIC] the parser rule is the current form *)
ALPHA_NUM    = LOWER_ALPHA | UPPER_ALPHA | DIGIT ;

(* [ALIAS ASCII_DIGIT] the parser rule is the current form *)
DIGIT        = "0" | ... | "9" ;

(* [ALIAS string_inner] the parser rule is the current form *)
CHAR         = (* any character except unescaped '"' *) ;


(* ================================================================ *)
(* 16. WHITESPACE AND COMMENTS                                      *)
(* ================================================================ *)

(* [ALIAS COMMENT] the parser rule is the current form *)
LINE_COMMENT = "//" , { NOT_NEWLINE } ;

(* [ALIAS COMMENT] the parser rule is the current form *)
BLOCK_COMMENT = "/*" , { NOT_STAR_SLASH } , "*/" ;

(* Doc comments generate documentation *)
(* [ALIAS COMMENT] the parser reads `///` as a line comment *)
DOC_COMMENT  = "///" , { NOT_NEWLINE } ;
