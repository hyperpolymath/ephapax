// Conformance test: value escaping its region — must be rejected.
// Expected: TypeError::RegionEscape for region `r` (E003), not a ParseError.
// The string is allocated in `r`, so the region block's result type
// `String@r` references `r` and would outlive it.

fn example(): I32 =
  region r {
    let s = String.new@r("hello")
    s
  }
