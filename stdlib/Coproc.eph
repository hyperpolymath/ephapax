//
// Ephapax Coprocessor API — a THIN typed dispatch boundary (v2 grammar).
//
// This module implements NO coprocessor kernels and depends on NO external
// framework. It is ephapax's OWN coprocessor dispatch surface. Its DESIGN —
// typed capability classes, a linear device-buffer lifecycle, and a thin
// C-ABI seam — follows the pattern Axiom.jl established (which demonstrated
// this shape across the full range of coprocessor types). ephapax models
// that pattern; it does NOT import, depend on, co-own, or forward to Axiom.
// ephapax owns its own seam end-to-end.
//
// The shared seam is a thin C ABI: `libephapax_coproc.so` (see
// `tools/coproc/ephapax_coproc.zig`) exports flat `eph_coproc_*` symbols
// that dispatch to whatever native coprocessor backend is linked behind
// them. ephapax reaches them through the typed `extern "ephapax_coproc"`
// block below. Raw variadic `__ffi(...)` is rejected since v2 plan rung E1:
// a typed `extern` declaration is the only FFI path. This is a minimal
// migration that restates the old call sites. The capability tag stays I32
// because the language has no I64 literal or I32-to-I64 conversion yet, but
// the shim exports `cap_tag: i64`. Nothing widens it today: a host that
// registers the Zig exports directly fails at instantiation on these two
// imports. The full port, including the tag width (or a widening host
// adapter), the linearity annotation on `CoprocBuf`, the wire types and a
// host binding for the `ephapax_coproc` import module, is rung E10.
// The interpreter's `-L` / `[ffi:stub]` path served only raw `__ffi`, so
// it no longer reaches this seam.

module Coproc

// ── The C-ABI seam (`tools/coproc/ephapax_coproc.zig`) ────────────────────
extern "ephapax_coproc" {
  fn eph_coproc_available(cap_tag: I32): I64
  fn eph_coproc_upload(cap_tag: I32, data_ptr: I64, len: I64): I64
  fn eph_coproc_dispatch(buf_id: I64, op: I64, arg0: I64, arg1: I64): I64
  fn eph_coproc_download(buf_id: I64, out_ptr: I64): I64
  fn eph_coproc_release(buf_id: I64): I64
}

// ── Capabilities ──────────────────────────────────────────────────────────
//
// The ten coprocessor classes (the coverage this design targets). The
// declaration order documents the intent; the wire contract with the Zig
// shim is made explicit by `cap_tag` below.
pub data Capability =
  | Audio     // digital signal processing (audio PU)
  | Crypto    // cryptographic acceleration
  | Maths     // general numeric / math acceleration
  | Physics   // physics processing unit
  | Gpu       // general-purpose GPU
  | Vector    // vector processing unit
  | Tensor    // tensor processing unit
  | Quantum   // quantum processing unit
  | Io        // I/O / host offload path
  | Fpga      // field-programmable gate array

// An opaque handle to a buffer living on a coprocessor. LINEAR: once
// uploaded it must be consumed EXACTLY ONCE — by `download` (pull the
// result) or `release` (abort). The linear checker therefore forbids
// use-after-download, use-after-release, double device-free, and silently
// leaking a device buffer (a dropped `CoprocBuf` is a type error, exactly
// as for `File!` / `Buffer!`). `dispatch` consumes a buffer and returns a
// fresh linear handle (consume-and-reborrow).
pub data CoprocBuf =
  | CoprocBuf(I64)

// ── Capability tag ────────────────────────────────────────────────────────
//
// The stable i64 tag for the shim's dispatch switch. Kept explicit (not
// reliant on the runtime's sum-discriminant encoding) so the wire contract
// survives any change to how nullary variants are represented: Audio=0 ..
// Fpga=9. (Returns I32: integer literals are I32 and there is no I64
// literal yet. The extern declarations therefore take the tag as I32,
// which does NOT match the shim's i64 parameter; see the header, rung E10.)
fn cap_tag(c: Capability): I32 =
  match c of
    | Audio => 0
    | Crypto => 1
    | Maths => 2
    | Physics => 3
    | Gpu => 4
    | Vector => 5
    | Tensor => 6
    | Quantum => 7
    | Io => 8
    | Fpga => 9
  end

// ── Availability probe (non-consuming) ────────────────────────────────────
//
// Returns 1 if the capability's coprocessor is reachable through the shim,
// 0 otherwise (including when `libephapax_coproc.so` is not linked). Lets a
// caller branch to a pure path BEFORE allocating any linear `CoprocBuf`.
fn available(c: Capability): I64 =
  eph_coproc_available(cap_tag(c))

// ── Upload: host buffer -> LINEAR device handle ───────────────────────────
//
// `data_ptr`/`len` describe a host-side byte buffer. Produces a linear
// `CoprocBuf` bound to the active region.
// (The `match raw` wrapper is a v2-grammar accommodation: a constructor
// application is currently only accepted in match-arm tail position, the
// same shape `decode_msg` uses in the v2 fixtures.)
fn upload(c: Capability, data_ptr: I64, len: I64): CoprocBuf =
  let raw = eph_coproc_upload(cap_tag(c), data_ptr, len)
  match raw of
    | _ => CoprocBuf(raw)
  end

// ── Dispatch: run an op, consume-and-reborrow ─────────────────────────────
//
// Consumes `buf`, runs coprocessor op `op` (two i64 operands), and returns a
// FRESH linear handle to the result buffer. Mirrors the linear reborrow of a
// streaming retry.
fn dispatch(buf: CoprocBuf, op: I64, arg0: I64, arg1: I64): CoprocBuf =
  match buf of
    | CoprocBuf(id) => CoprocBuf(eph_coproc_dispatch(id, op, arg0, arg1))
  end

// ── Download: TERMINAL consumer that pulls the result ─────────────────────
//
// Consumes `buf` and copies its contents to the host buffer at `out_ptr`.
// Returns a status code (0 = ok). After `download` the handle is gone —
// reusing it is a static linear-use-after-consume error.
fn download(buf: CoprocBuf, out_ptr: I64): I64 =
  match buf of
    | CoprocBuf(id) => eph_coproc_download(id, out_ptr)
  end

// ── Release: TERMINAL abort consumer ──────────────────────────────────────
//
// Consumes `buf` and frees the device buffer WITHOUT downloading. Returns a
// status code (0 = ok) — the abort path that still satisfies linearity so no
// device buffer is ever leaked.
fn release(buf: CoprocBuf): I64 =
  match buf of
    | CoprocBuf(id) => eph_coproc_release(id)
  end
