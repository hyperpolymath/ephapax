#
# PROOF-STATUS.a2ml — machine-readable Coq proof state
#
# Historical schema snapshot from 2026-05-27 (post-L1.A through L1.F).
# Its legacy counts and classifications below are superseded by the
# current boundary block and PROOF-NEEDS.adoc. Do not consume historical
# L1 debt rows as open obligations without checking pinned counterexamples.
#
# Human-readable source of truth: PROOF-NEEDS.adoc and EXPLAINME.adoc.

[metadata]
version = "1.0.0"
snapshot-date = "2026-05-27"
design-branch = "proof/l1-region-threading-design"
spec-doc = "formal/PRESERVATION-DESIGN.adoc"
counterexample = "formal/Counterexample.v"

[current-proof-boundary]
status-date = "2026-11-01"
source-of-truth = "PROOF-NEEDS.adoc"
legacy-preservation = "refuted-as-stated; durable Admitted retained; five-Qed regression pinned"
step-pop-disjoint-from-type-l1 = "refuted-as-stated; Counterexample_StepPop.v"
preservation-l1 = "refuted-as-stated in Linear instance; Counterexample_PreservationL1.v"
preservation-l2 = "no unconditional theorem declared; see Counterexample_L2.v and Counterexample_L2_nested.v"
mathesis-grade = "not-claimed; current witnesses are Coq, not Grade 3 Agda receipts"
proof-policy = "hyperpolymath/mathesis/estate-mathematical-architecture; hyperpolymath/standards/3-practice/PROOF-POLICY.adoc"

# ============================================================================
# FILES — what's in formal/ and its proof-status posture
# ============================================================================

[[files]]
path = "formal/Syntax.v"
purpose = "AST + region/context infrastructure"
status = "stable"
qed-only = true

[[files]]
path = "formal/Typing.v"
purpose = "legacy has_type judgment (single R, no threading)"
status = "frozen"
qed-only = true
note = "Retained for legacy preservation. L1 judgment lives in TypingL1.v."

[[files]]
path = "formal/TypingL1.v"
purpose = "L1 has_type_l1 judgment (R-threaded)"
status = "stable"
qed-only = true
landed-in = "PR-155"

[[files]]
path = "formal/Counterexample.v"
purpose = "verified counterexample to preservation as originally stated"
status = "stable"
qed-only = true
key-lemmas = [
  "bad_typable",
  "bad_step",
  "bad_post_untypable",
  "bad_input_untypable_l1"
]

[[files]]
path = "formal/Semantics.v"
purpose = "operational step + legacy preservation"
status = "frozen-refuted"
admit-count = 1
note = "The legacy preservation statement is false as stated; its durable Admitted is pinned by the five-Qed formal/Counterexample.v regression. Do not treat as ordinary debt."

[[files]]
path = "formal/Semantics_L1.v"
purpose = "L1 helper lemmas, false unrestricted theorem statements, and scoped regressions"
status = "active-with-refuted-preservation-statements"
admit-count = 2
axiom-count = 0
admitted-lemma-count = 2
note = "Current two outer Admitted lemmas are refuted as stated by Counterexample_StepPop.v and Counterexample_PreservationL1.v; replacements require redesign, not proof completion."
landed-in = ["PR-157", "PR-158", "PR-159", "PR-160", "PR-161", "PR-162", "PR-163"]

# ============================================================================
# L1 PROOF CHAIN — Qed lemmas
# ============================================================================

[[qed-lemmas]]
name = "remove_first_eq_l1"
file = "Semantics_L1.v"
purpose = "trivial bridge between remove_first and remove_first_L1"

[[qed-lemmas]]
name = "value_R_G_preserving_l1"
file = "Semantics_L1.v"
landed-in = "PR-158"
swarm-stream = "L1.A"
purpose = "value v at R;G -| R';G' implies R'=R and G'=G"

[[qed-lemmas]]
name = "region_shrink_preserves_typing_l1"
file = "Semantics_L1.v"
landed-in = "PR-159"
swarm-stream = "L1.B"
purpose = "value-restricted region shrinking via region_shrink_msperm"
note = "The unrestricted general statement was refuted in Counterexample_RegionShrink.v; this Qed value corollary is the restricted replacement."

[[qed-lemmas]]
name = "subst_preserves_typing_l1"
file = "Semantics_L1.v"
landed-in = "PR-160"
swarm-stream = "L1.C"
purpose = "substitution preserves L1 typing (strengthened statement)"
note = "Original statement was unsound (typed v at independent R1); strengthened to share R with body."

[[qed-lemmas]]
name = "loc_retype_at_R_l1"
file = "Semantics_L1.v"
landed-in = "PR-162"
swarm-stream = "L1.F"
purpose = "ELoc l r retypes at any R_inner that has r — pure T_Loc_L1 consequence"
note = "Replaces the original UNSOUND axiom of the same name. Adds 'In r R_inner' premise that the axiom omitted."

[[qed-lemmas]]
name = "count_occ_le_l1"
file = "Semantics_L1.v"
landed-in = "PR-163"
swarm-stream = "L1.E"
purpose = "typing is region-count monotonic: count r R' ≤ count r R"

[[qed-lemmas]]
name = "count_occ_in_input_l1"
file = "Semantics_L1.v"
landed-in = "PR-163"
swarm-stream = "L1.E"
purpose = "corollary: In r R' implies In r R"

# ============================================================================
# PRESERVATION THEOREM
# ============================================================================

[preservation-l1]
file = "Semantics_L1.v"
landed-in = "PR-161"
swarm-stream = "L1.D"
status = "Admitted; refuted-as-stated"
cases-total = 33
cases-qed = 29
cases-admit = 4
note = "The theorem statement is refuted by Counterexample_PreservationL1.v (Linear instance). Case counts are historical; do not treat residual admits as unfinished routine proof debt."

# ============================================================================
# OUTSTANDING PROOF DEBT
# ============================================================================

[[proof-debt]]
id = "L1.B-residual-1"
file = "Semantics_L1.v"
line-anchor = "historical region_shrink_preserves_typing_l1_gen T_Region_Active_L1 shadowed"
class = "counterexample-refuted-statement"
tractable = false
diagnosis = "The unrestricted helper is refuted by Counterexample_RegionShrink.v; duplicate ambient region entries make single-entry removal unsound even under strict syntactic freeness."
closes-when = "Do not prove the old statement. Restricted region_shrink_msperm and value/neutral corollaries replace it for current call sites."

[[proof-debt]]
id = "L1.D-StringConcat"
file = "Semantics_L1.v"
line-anchor = "historical preservation_l1 S_StringConcat_Step2 support claim"
class = "counterexample-refuted-statement"
tractable = false
diagnosis = "The unrestricted helper step_pop_disjoint_from_type_l1 is refuted by Counterexample_StepPop.v; Counterexample_PreservationL1.v also refutes the proposed value-anchored restriction along this path."
closes-when = "Do not prove the old conclusion. Define and prove a separately stated sound replacement after redesign."

[[proof-debt]]
id = "L1.D-App"
file = "Semantics_L1.v"
line-anchor = "preservation_l1 S_App_Step2"
class = "counterexample-refuted-statement"
tractable = false
diagnosis = "Historical S_App_Step2 conjecture; the unrestricted preservation_l1 theorem is refuted by Counterexample_PreservationL1.v."
closes-when = "Not by proving this statement. State a sound replacement after judgment/step redesign."
follow-up = "see PROOF-NEEDS.adoc current L1 boundary"

[[proof-debt]]
id = "L1.D-Pair"
file = "Semantics_L1.v"
line-anchor = "preservation_l1 S_Pair_Step2"
class = "counterexample-refuted-statement"
tractable = false
diagnosis = "Historical S_Pair_Step2 conjecture; the unrestricted preservation_l1 theorem is refuted by Counterexample_PreservationL1.v."
closes-when = "Not by proving this statement. State a sound replacement after judgment/step redesign."
follow-up = "see PROOF-NEEDS.adoc current L1 boundary"

[[proof-debt]]
id = "L1.C-region-liveness"
file = "Semantics_L1.v"
line-anchor = "historical region_liveness_at_split_l1 (removed 2026-06-26)"
class = "refuted-statement-replaced"
tractable = false
diagnosis = "The unconditional region-liveness claim was false in the active-region exit case and has been removed. The current true lemma carries an explicit no-exit premise."
closes-when = "No closure of the old statement. Preserve region_liveness_no_exit_l1_gen and val_region_no_exit as the restricted boundary."

# ============================================================================
# DOCUMENTATION POINTERS
# ============================================================================

[docs]
design = "formal/PRESERVATION-DESIGN.adoc"
handoff = "formal/PRESERVATION-HANDOFF.adoc"
roadmap = "ROADMAP.adoc"
counterexample = "formal/Counterexample.v"
disambiguation = "nextgen-languages/docs/disambiguation/ephapax-vs-affinescript.md"

[docs.sections]
preservation-design-§4-1-judgment = "L1 judgment signature"
preservation-design-§4-5-statement = "Preservation under the new judgment"
preservation-design-§4-7-status = "L1 closure status (2026-05-27)"
preservation-design-§4-8-soundness-finding = "T_Lam_L1 + T_Var_*_L1 are too permissive — soundness gap surfaced by L1.E"
preservation-design-§12-15-bounds = "Proof-debt bounds (named cases that remain)"
preservation-design-§12-16-roadmap = "v2 echo-as-foundation forward look"

# ============================================================================
# BUILD VERIFICATION
# ============================================================================

[build]
coq-version = "8.18.0"
project-file = "formal/_CoqProject"
invocation = "coq_makefile -f _CoqProject -o Makefile && make"
last-clean-build = "2026-05-27 (historical; no fresh build in 2026-11 audit)"
current-audit = "coqc unavailable; GitHub run 40435929887 (2026-10-27) succeeded overall but skipped Coq build job; not a proof-build receipt"
modules = [
  "Syntax",
  "Typing",
  "TypingL1",
  "Semantics",
  "Semantics_L1",
  "Counterexample"
]
