// Conformance test: branches consume different linear bindings — must be rejected.
// Expected: TypeError::BranchLinearityMismatchDetailed (E005, "branches
// consume different linear resources"), not a ParseError.

fn example(cond: Bool): I32 =
  let! x = 42
  if cond then x else 0
