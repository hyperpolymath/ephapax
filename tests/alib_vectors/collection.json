{"category":"collection","format":"alib-vectors-1","operations":[{"name":"contains","parameters":[{"name":"collection","type":"Collection[A]"},{"name":"element","type":"A"}],"result":"Boolean","signature":"contains: Collection[A], A -> Boolean","source":"specs/collection/contains.adoc","vectors":[{"description":"Element is present in collection","input":{"collection":[1,2,3,4,5],"element":3},"output":true},{"description":"Element is not present in collection","input":{"collection":[1,2,3,4,5],"element":6},"output":false},{"description":"Empty collection contains no elements","input":{"collection":[],"element":1},"output":false},{"description":"Single element collection contains that element","input":{"collection":[1],"element":1},"output":true},{"description":"String element is present","input":{"collection":["a","b","c"],"element":"b"},"output":true},{"description":"Element appears multiple times (still returns true)","input":{"collection":[1,2,1,3,1],"element":1},"output":true}]},{"name":"empty","parameters":[{"type":"Collection[A]"}],"result":"Boolean","signature":"empty: Collection[A] -> Boolean","source":"specs/collection/empty.adoc","vectors":[{"description":"Empty collection is empty","input":[[]],"output":true},{"description":"Single-element collection is not empty","input":[[1]],"output":false},{"description":"Multiple-element collection is not empty","input":[[1,2,3]],"output":false},{"description":"String collection with elements is not empty","input":[["a","b"]],"output":false}]},{"name":"filter","parameters":[{"name":"collection","type":"Collection[A]"},{"name":"predicate","type":"Function[A -> Boolean]"}],"result":"Collection[A]","signature":"filter: Collection[A], Function[A -> Boolean] -> Collection[A]","source":"specs/collection/filter.adoc","vectors":[{"description":"Filter numbers greater than 2","input":{"collection":[1,2,3,4,5],"predicate":"x => greater_than(x, 2)"},"output":[3,4,5]},{"description":"Filter even numbers","input":{"collection":[1,